# Copy these into your server's environment (they are NOT loaded automatically).
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-a-long-random-value   # python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_ALLOWED_HOSTS=sheet.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sheet.example.com

# PostgreSQL (required in production)
DJANGO_DB_NAME=marine_sheet
DJANGO_DB_USER=marine_app            # a normal role that owns only this database, not a superuser
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=db.internal
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=verify-full        # require = encrypt only; verify-full = encrypt + verify the server
DJANGO_DB_SSLROOTCERT=/etc/ssl/certs/db-ca.pem

# Letterhead and pictures: logo.jpg, stamp.jpg, footer.jpg (LOG letter, receipt), brand.png (sidebar logo),
# terminals\<CODE>.png|.jpg (Live data). Outside the project, readable only by the app's account, never in git.
DJANGO_LETTERHEAD_DIR=C:\marine_letterhead

# Sessions and admin
DJANGO_SESSION_IDLE_MINUTES=60
# DJANGO_ADMIN_URL=some-private-path/

# Behind a reverse proxy (nginx, a load balancer...):
# DJANGO_BEHIND_PROXY=1                          # trust X-Forwarded-Proto for HTTPS detection
# DJANGO_CLIENT_IP_HEADER=X-Forwarded-For        # so login lock-out sees real client addresses

# API rate limits per 10 minutes (defaults shown)
# DJANGO_RATE_LIMIT_WRITES_PER_USER=120
# DJANGO_RATE_LIMIT_WRITES_PER_IP=600
# DJANGO_RATE_LIMIT_EXPORTS_PER_USER=20

# Alerting: 10 lock-outs / denied requests / server errors in 10 minutes -> one sheet.alert record, e-mailed if set
# DJANGO_ALERT_EMAILS=security@example.com,it@example.com
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_FROM=marine-sheet@example.com

# Logs to a rotating file as well as the console
# DJANGO_LOG_FILE=/var/log/marine-sheet/app.log
